# systemd unit template, rendered and installed by deploy/install-pi.sh
# (__USER__, __HOME__ and __NODE__ are filled in for the Pi).
[Unit]
Description=HK agent (Harman Kardon amp + Hue bridge)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__HOME__/hk-agent
EnvironmentFile=__HOME__/hk-agent/.env
ExecStart=__NODE__ dist/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
