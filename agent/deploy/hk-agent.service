# systemd unit for a Raspberry Pi. Install:
#   sudo cp deploy/hk-agent.service /etc/systemd/system/
#   sudo systemctl enable --now hk-agent
#   journalctl -u hk-agent -f
[Unit]
Description=HK agent (Harman Kardon amp + Hue bridge)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/hk/agent
EnvironmentFile=/home/pi/hk/agent/.env
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
