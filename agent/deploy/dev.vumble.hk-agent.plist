<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent for a Mac. Install:
    cp deploy/dev.vumble.hk-agent.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.vumble.hk-agent.plist
  Logs: ~/Library/Logs/hk-agent.log
  First replace /Users/you with your home folder, and the node path with the output of `which node`.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.vumble.hk-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>--env-file=.env</string>
    <string>dist/index.js</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/you/hk/agent</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/you/Library/Logs/hk-agent.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/you/Library/Logs/hk-agent.log</string>
</dict>
</plist>
