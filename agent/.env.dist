# Port the agent listens on
PORT=8787
# Shared secret the web app sends as "Authorization: Bearer <token>". Generate one: openssl rand -hex 24
AGENT_TOKEN=
# Harman Kardon amp on the LAN (port 10025 is fixed)
HK_IP=192.168.1.37
# Sources shown as buttons, comma separated, as the amp names them
HK_SOURCES="Radio,TV,Cable Sat"
# Hue bridge. Recent firmware only answers over HTTPS (self-signed certificate, accepted by the agent)
HUE_URL=https://192.168.1.10
# "username" created on the bridge (the 40-character key from the link-button pairing)
HUE_USERNAME=
# Set to 1 to run without any device (fake lights, HK commands only logged)
# MOCK=1
# Optional: reusable Tailscale auth key (admin console → Settings → Keys). When set, deploy/install-pi.sh
# also installs Tailscale on the Pi and opens the Funnel that gives the agent its public HTTPS URL.
TS_AUTHKEY=
