# Port the agent listens on
PORT=8787
# Shared secret the web app sends as "Authorization: Bearer <token>". Generate one: openssl rand -hex 24
AGENT_TOKEN=
# Harman Kardon amp on the LAN (port 10025 is fixed)
HK_IP=192.168.1.37
# Sources shown as buttons, comma separated, as the amp names them
HK_SOURCES="TV,Radio,Cable Sat"
# Hue bridge. Recent firmware only answers over HTTPS (self-signed certificate, accepted by the agent)
HUE_URL=https://192.168.1.10
# "username" created on the bridge (the 40-character key from the link-button pairing)
HUE_USERNAME=
# Set to 1 to run without any device (fake lights, HK commands only logged)
# MOCK=1
# Optional: reusable Tailscale auth key (admin console → Settings → Keys). When set, deploy/install-pi.sh
# also installs Tailscale on the Pi and opens the Funnel that gives the agent its public HTTPS URL.
TS_AUTHKEY=
# Name of the Pi in Tailscale, which is the first part of the public URL (https://hk.<tailnet>.ts.net)
TS_HOSTNAME=hk

# Optional: Spotify. Create an app at https://developer.spotify.com/dashboard with the redirect URIs
# https://hk.vumble.dev/ and http://127.0.0.1:5181/ (dev). The agent keeps the tokens in spotify.json next to dist/.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Spotify Connect device to wake up when nothing is playing (name as shown in the Spotify app)
SPOTIFY_DEFAULT_DEVICE=Volumio

# Optional: Genius API token for the lyrics tab (https://genius.com/api-clients)
GENIUS_TOKEN=

# Optional: self-update from GitHub (POST /update, or the button in the app's settings). The agent downloads
# the release tagged "latest" that the agent-release workflow publishes. A private repo needs a fine-grained
# token with read access to its contents.
GITHUB_REPO=ValentinMumble/hk
GITHUB_TOKEN=
