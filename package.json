{
  "name": "hk",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5181 --strictPort",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"agent/src/**/*.ts\" index.html",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"agent/src/**/*.ts\" index.html",
    "format:mac": "xcrun swift-format format --recursive mac/Sources --in-place",
    "test": "vitest run src"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "prettier": "^3.8.4",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitest": "4.1.12"
  }
}
